# LLM 默认端点(OpenAI 兼容,所有参赛模型共用;模型名单在前端「模型管理」页维护)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxx
LLM_TEMPERATURE=0.7

# 每个模型账户的初始虚拟资金
INITIAL_CASH=1000000

# 调度: 每交易日一次全量决策 + 盘中持仓监控
SCHEDULE_ENABLED=true
DAILY_DECISION_TIME=14:35
MONITOR_INTERVAL_MINUTES=15

# 自动选股: 每交易日规则初筛 + LLM 精选入共享股池
STOCK_SELECT_ENABLED=true
STOCK_SELECT_TIME=14:05
POOL_MAX=8

# 盘中复审阈值
TAKE_PROFIT_REVIEW_PCT=0.15
STOP_LOSS_REVIEW_PCT=-0.08
DEEP_LOSS_PCT=-0.15
