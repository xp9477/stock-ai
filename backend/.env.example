# OpenAI 兼容 LLM 端点。模型名单在「模型/策略」页维护。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxx
LLM_TEMPERATURE=0.7

# 行情/财务主源
FUYAO_API_KEY=
# 可选备份；默认不作静默降级
TUSHARE_TOKEN=

# 收盘后候选池与条件计划；盘中监控只告警/复审
SCHEDULE_ENABLED=true
STOCK_SELECT_ENABLED=true
STOCK_SELECT_TIME=15:30
DAILY_DECISION_TIME=16:00
MONITOR_INTERVAL_MINUTES=5
POOL_MAX=30

# 告警线；不会触发自动卖出
TAKE_PROFIT_REVIEW_PCT=0.15
STOP_LOSS_REVIEW_PCT=-0.08
DEEP_LOSS_PCT=-0.15
DEEP_LOSS_AUTO_EXECUTE=false

# 本地开发数据库；Docker 运行时通常由挂载目录覆盖
DB_PATH=stock_ai.db
