# Keep this file outside Git after copying it to /etc/stock-ai/emt-bridge.env.
# The checked-in example contains no credentials.
EMT_MODE=simulation
EMT_READ_ONLY=true
EMT_SDK_DIR=/opt/emt-api/python/lib/linux
EMT_SERVER_HOST=61.152.230.41
EMT_SERVER_PORT=19088
EMT_USER=replace-locally
EMT_PASSWORD=replace-locally
EMT_LOCAL_IP=replace-with-ubuntu-lan-ip
EMT_CLIENT_ID=31
EMT_ACCOUNT_REF=emt-sim-primary
EMT_REFRESH_SECONDS=30
EMT_SNAPSHOT_PATH=/var/lib/stock-ai/broker/emt_snapshot.json
EMT_JOURNAL_PATH=/var/lib/stock-ai/broker/emt_events.jsonl
EMT_LOG_DIR=/var/lib/stock-ai/broker/vendor-logs
