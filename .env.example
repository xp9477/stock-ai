# Docker deployment example. The API binds to localhost unless you explicitly
# expose it; add authentication before changing this to 0.0.0.0.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8000

# Read-only normalized snapshot produced by the isolated EMT simulation bridge.
# Broker credentials never enter this web container.
BROKER_SNAPSHOT_PATH=/data/broker/emt_snapshot.json
BROKER_SNAPSHOT_MAX_AGE_SECONDS=120

# OpenAI-compatible LLM endpoint. Model IDs are managed in the web UI.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxx
LLM_TEMPERATURE=0.7

# Primary market/fundamental data source.
FUYAO_API_KEY=
# Optional fallback; disabled when empty.
TUSHARE_TOKEN=

# After-close candidate selection and conditional-plan generation.
SCHEDULE_ENABLED=true
STOCK_SELECT_ENABLED=true
STOCK_SELECT_TIME=15:30
DAILY_DECISION_TIME=16:00
MONITOR_INTERVAL_MINUTES=5
POOL_MAX=30

# Intraday thresholds create alerts/review tasks only. They never sell.
TAKE_PROFIT_REVIEW_PCT=0.15
STOP_LOSS_REVIEW_PCT=-0.08
DEEP_LOSS_PCT=-0.15
DEEP_LOSS_AUTO_EXECUTE=false
SHALLOW_LINE_ALERT_ONLY=true

# Capital is a code-owned, non-editable contract: authorized capital is
# CNY 100,000 and maximum stock exposure is CNY 80,000. Do not add legacy
# INITIAL_CASH or capitalized rule-racing settings here.
