# LLM 默认端点(OpenAI 兼容,所有参赛模型共用;模型名单在前端「模型管理」页维护)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxx
LLM_TEMPERATURE=0.7

# 每个模型账户的初始虚拟资金
INITIAL_CASH=1000000

# 同花顺扶摇（行情/财务/估值/ETF 唯一主源）https://fuyao.aicubes.cn/admin
FUYAO_API_KEY=

# 可选：以后不够用再买 Tushare（默认不使用）
# TUSHARE_TOKEN=

# 调度: 每交易日一次全量决策 + 盘中持仓监控
SCHEDULE_ENABLED=true
DAILY_DECISION_TIME=14:35
MONITOR_INTERVAL_MINUTES=15

# 共享股池上限（赛马宇宙）
POOL_MAX=30

# S2 因子组合：周频前 N 等权
FACTOR_TOP_N=10

# 盘中: 浅线告警 / 深亏强制砍
TAKE_PROFIT_REVIEW_PCT=0.15
STOP_LOSS_REVIEW_PCT=-0.08
DEEP_LOSS_PCT=-0.15
DEEP_LOSS_AUTO_EXECUTE=true
SHALLOW_LINE_ALERT_ONLY=true

# 赛马样本门槛
RACE_MIN_TRADE_DAYS=60
RACE_MIN_CLOSED_TRADES=100
